# ==============================================================================
# Modular Auth Foundation - API Environment Variables (Example Template)
# CRITICAL: Copy to .env for local development. NEVER commit real secrets to Git!
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Allowed Origins for CORS (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# Supabase Auth & Project Configuration
# Found in: Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Backend service-role key (NEVER expose to frontend!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
# Supabase JWT Secret (for symmetric verification) or JWKS URL (for asymmetric verification)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
