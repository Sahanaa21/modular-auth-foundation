{
  "name": "modular-auth-foundation",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade reusable authentication and authorization foundation for React and Node.js",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
