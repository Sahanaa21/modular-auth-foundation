# ==============================================================================
# Modular Auth Foundation - Environment Variables (Example Template)
# CRITICAL: Copy this file to .env before starting the server.
# NEVER commit real credentials, service-role keys, or access tokens to Git!
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Allowed Origins for CORS (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# Supabase Auth & Project Configuration
# Project URL (Default: ArchScale Supabase project)
SUPABASE_URL=https://vsllykwuqqmbitxvpuod.supabase.co

# Supabase Backend Service-Role Key (CRITICAL: Required for authoritative database queries)
# Retrieve from: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Supabase JWT Secret (Optional if project uses asymmetric ES256/RS256 with remote JWKS)
# For legacy HS256 projects: Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
